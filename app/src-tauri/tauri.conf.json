{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Zevrigo Explorer",
  "version": "0.1.0",
  "identifier": "com.zevrigo.explorer",
  "build": {
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Zevrigo Explorer",
        "url": "https://zevrigo.ratuaurion.store/",
        "create": false,
        "width": 1280,
        "height": 860,
        "minWidth": 800,
        "minHeight": 600
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; object-src 'none'; base-uri 'none'; form-action 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "publisher": "Zevrigo",
    "license": "MIT OR Apache-2.0",
    "licenseFile": "PRIVASI-DAN-LISENSI.txt",
    "homepage": "https://github.com/badakbesi/zevrigo-explorer",
    "copyright": "Pembuat Zevrigo, MIT OR Apache-2.0",
    "shortDescription": "Zevrigo Explorer (ZVRG), jaringan demo regtest",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png",
      "icons/icon.ico"
    ]
  }
}
